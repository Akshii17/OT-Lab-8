diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index cd25557..afbab41 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -110,3 +110,19 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+// setpriority(pid, prio): set priority (0 highest .. 20 lowest) of process pid. Returns 0 or -1.
+uint64
+sys_setpriority(void)
+{
+  int pid, prio;
+  argint(0, &pid);
+  argint(1, &prio);
+  if (prio < 0 || prio > 20) return -1;
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->pid == pid && p->state != UNUSED) { p->priority = prio; release(&p->lock); return 0; }
+    release(&p->lock);
+  }
+  return -1;
+}
diff --git a/user/schedbench.c b/user/schedbench.c
new file mode 100644
index 0000000..0f5b6ed
--- /dev/null
+++ b/user/schedbench.c
@@ -0,0 +1,23 @@
+// schedbench: 3 workloads to compare the scheduler before/after the patch.
+// usage: schedbench 1|2|3     (prints turnaround ticks per child)
+#include "kernel/types.h"
+#include "user/user.h"
+
+static void spin(int n) { volatile int x = 0; for (int i = 0; i < n; i++) for (int j = 0; j < 1000; j++) x += j; }
+
+static void child(int prio, int work, int sleepy, int start) {
+  setpriority(getpid(), prio);
+  for (int r = 0; r < (sleepy ? 10 : 1); r++) { spin(work/(sleepy ? 10 : 1)); if (sleepy) pause(1); }
+  printf("pid %d prio %d turnaround %d ticks\n", getpid(), prio, uptime() - start);
+  exit(0);
+}
+
+int main(int argc, char *argv[]) {
+  int w = argc > 1 ? atoi(argv[1]) : 1, start = uptime(), n = 0;
+  if (w == 1)      { for (int i = 0; i < 4; i++) { if (fork() == 0) child(i < 2 ? 2 : 18, 2000, 0, start); n++; } }  // CPU-bound, mixed priority
+  else if (w == 2) { for (int i = 0; i < 12; i++) { if (fork() == 0) child(10, 200, 0, start); n++; } }               // many short jobs
+  else             { for (int i = 0; i < 4; i++) { if (fork() == 0) child(i < 2 ? 5 : 15, 1500, i % 2, start); n++; } } // CPU + sleepy mix
+  for (int i = 0; i < n; i++) wait(0);
+  printf("workload %d total %d ticks\n", w, uptime() - start);
+  exit(0);
+}
